# Copy to .env at the repository root. Never commit .env.
# These values are for local containers only (docker-compose.yml) and are not secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Dev database (db-dev, port 5432). Integration tests use port 5433 / noteapp_test.
# E2E uses port 5433 / noteapp_e2e. A git worktree should use its own database name.
DATABASE_URL=postgresql://noteapp:noteapp_dev_only@localhost:5432/noteapp_dev

# At least 32 bytes each, and different from each other. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-bytes-aaaa
OTP_HMAC_SECRET=replace-me-with-another-32-random-bytes-bbbb

# Origin allowed by the Origin check on /auth/refresh and /auth/logout.
APP_ORIGIN=http://localhost:5173
# true in production only (Secure cookie).
COOKIE_SECURE=false

# Docker full profile (`docker compose --profile full up --build`): the backend container reads
# JWT_ACCESS_SECRET and OTP_HMAC_SECRET from this file. Optional overrides:
# DOCKER_DB_PASSWORD=...          (default noteapp_docker_only; the database is not published)
# DOCKER_APP_ORIGIN=http://localhost:8080

JOBS_ENABLED=true
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Frontend dev server proxy target.
VITE_API_PROXY_TARGET=http://localhost:3000

# OTP_TEST_FILE is only allowed when NODE_ENV=test. Startup fails if it is set otherwise.
